# OpenRouter API key used by the server-side PDF analyzer.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# Optional OpenRouter model. openrouter/free automatically selects an available free model.
OPENROUTER_MODEL="openrouter/free"

# Optional legacy Gemini key. Not used by the PDF analyzer anymore.
GEMINI_API_KEY=""

# Optional DeepSeek API Key.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# URL where the application is hosted.
APP_URL="MY_APP_URL"

# Browser-visible API URL used by the React frontend.
# Local development can use http://localhost:3000.
# Production should point to the public Render API service.
VITE_API_BASE_URL="https://v-shiroya-api.onrender.com"

# Optional production frontend origin for the API CORS proxy.
FRONTEND_URL=""
