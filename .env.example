# OPENROUTER_API_KEY: Optional OpenRouter API Key for scanning and analyzing policy PDFs.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional DeepSeek API Key.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: URL where the application is hosted.
APP_URL="MY_APP_URL"

# Browser-visible API URL used by the React frontend.
# Local development can use http://localhost:3000.
# Production should point to the public Render API service.
VITE_API_BASE_URL="https://v-shiroya-api.onrender.com"

# Optional production frontend origin for the API CORS proxy.
# Leave unset to allow all origins, or set this to your Firebase/custom domain.
FRONTEND_URL=""
